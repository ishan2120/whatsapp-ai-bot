# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Meta WhatsApp Webhook Verification Token
META_VERIFY_TOKEN=my_secure_meta_verify_token_123

# Database Configuration (SQLite with AsyncIO support)
DATABASE_URL=sqlite+aiosqlite:///./whatsapp_bot.db

# Meta Graph API Base URL / Version
META_GRAPH_API_VERSION=v20.0
